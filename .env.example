# Content Studio 配置（复制为 .env 后填写；.env 不进版本库）
# 运行时可改项（LLM 密钥/检索通道/品牌等）在设置页维护，存数据库 app_settings

# --- 服务 ---
# HOST=127.0.0.1
# PORT=8100
# DATA_DIR=data

# --- 部署与安全（云部署 / Nginx 反代 + HTTPS）---
# COOKIE_SECURE=1        # HTTPS 下置 1：会话 Cookie 只经加密通道（配好证书后开启）
# LOGIN_MAX_FAILS=5      # 同一账号在窗口内的登录失败上限（超出即锁）
# LOGIN_WINDOW_SEC=900   # 失败计数窗口（秒）
# LOGIN_IP_MAX=40        # 同一来源 IP 窗口内失败上限（防撞库扫号）

# --- LLM（GLM Coding Plan 端点，套餐额度）---
LLM_PROVIDER=glm
ZHIPU_API_KEY=
LLM_MODEL=glm-5
# Coding Plan 端点不含联网搜索资源，检索锁定 DDG（充值按量后可在设置页改回 auto）
SEARCH_PROVIDER=ddg

# --- ASR 转写（口播转文字）---
# ASR_MODEL=small        # 首选 small（466MB，CPU 够用）；模型下载慢可加 HF_ENDPOINT 镜像
# HF_ENDPOINT=https://hf-mirror.com

# --- 蝉镜数字人开放平台（口播数字人功能需要；也可在设置页填写）---
# CHANJING_APP_ID=
# CHANJING_SECRET_KEY=

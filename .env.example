# Content Studio 配置（复制为 .env 后填写；.env 不进版本库）

# --- 服务 ---
# HOST=127.0.0.1
# PORT=8100
# DATA_DIR=data

# --- 部署与安全（云部署 / Nginx 反代 + HTTPS）---
# COOKIE_SECURE=1        # HTTPS 下置 1：会话 Cookie 只经加密通道（配好证书后开启）
# LOGIN_MAX_FAILS=5      # 同一账号在窗口内的登录失败上限（超出即锁）
# LOGIN_WINDOW_SEC=900   # 失败计数窗口（秒）
# LOGIN_IP_MAX=40        # 同一来源 IP 窗口内失败上限（防撞库扫号）

# --- LLM（GLM 为主，DeepSeek 备选；切换 = 改 LLM_PROVIDER + 填对应 key）---
LLM_PROVIDER=glm
ZHIPU_API_KEY=
# 切换 DeepSeek：LLM_PROVIDER=deepseek + 填 DEEPSEEK_API_KEY（模型默认 deepseek-chat）
# DEEPSEEK_API_KEY=
LLM_MODEL=glm-5

# --- 外部容器（docker 部署后自动探测，见 docs/技术方案.md §10）---

# --- 视频 / 剪辑 ---
# ASR_MODEL=large-v3

# --- 发布（P4）---
# 抖音在线拆解：从已登录 douyin.com 的浏览器导出 cookies.txt 后启用
# DOUYIN_COOKIES_FILE=data/douyin_cookies.txt

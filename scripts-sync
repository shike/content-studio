#!/bin/bash
sqlite3 /srv/content-studio/data/studio.db "SELECT '#' || id || ' ' || status || ' ' || progress || '% ' || substr(updated_at,1,19) FROM jobs WHERE type='article_kb_miner' ORDER BY id DESC LIMIT 1;"
cd /srv/content-studio && backend/.venv/bin/python - <<'PYEOF'
import hashlib, json, sqlite3, urllib.request, uuid
db = sqlite3.connect("/srv/content-studio/data/studio.db")
token = uuid.uuid4().hex + uuid.uuid4().hex
db.execute("INSERT INTO user_sessions(created_at,updated_at,token_hash,user_id,tenant_id,expires_at) VALUES(datetime('now'),datetime('now'),?,1,1,datetime('now','+1 hours'))", (hashlib.sha256(token.encode()).hexdigest(),))
db.commit(); db.close()
req = urllib.request.Request("http://127.0.0.1:8100/api/debug/tasks")
req.add_header("Cookie", f"cs_session={token}")
data = json.loads(urllib.request.urlopen(req, timeout=30).read())
print("任务总数:", len(data.get("tasks", [])))
for t in data.get("tasks", []):
    st = t.get("stack") or ""
    if "miner" in st or "ima" in st or "gateway" in st:
        print("== 命中:", t["name"], t["coro"])
        print(st[:1100])
PYEOF
